# =========================================================
# ⚙️ إعدادات المتجر وقاعدة البيانات (PostgreSQL / Supabase)
# =========================================================

PORT=3000
NODE_ENV=production

# 🔗 رابط الاتصال بقاعدة بيانات PostgreSQL (من Supabase أو أي مزود Postgres)
# مثال Supabase URI: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ☁️ إعدادات Supabase Storage لحفظ الصور والملفات بشكل دائم عند النشر على Render
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=uploads

# 🔐 الأمان والتشفير (مفتاح سري عشوائي لا يقل عن 32 حرف)
JWT_SECRET=super_secure_random_jwt_secret_key_minimum_32_characters_long_123456

# 👑 بيانات حساب المشرف الافتراضي
ADMIN_USERNAME=loueystore
ADMIN_PASSWORD=k6t6J8DHw79jGw3

# 📞 رقم واتساب الإدارة لاستقبال طلبات الاشتراك والاستفسارات
ADMIN_WHATSAPP_NUMBER=213665236042

# ✉️ إعدادات إرسال البريد الإلكتروني ورموز OTP (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="متجر الجملة" <your-email@gmail.com>

# 🌐 النطاقات المسموحة للـ CORS
ALLOWED_ORIGINS=https://your-app.onrender.com,http://localhost:3000
